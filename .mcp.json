{
	"mcpServers": {
		"context7": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp@4.1.1"
			],
			"tools": [
				"*"
			]
		},
		"docker": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"@hypnosis/docker-mcp-server@2.0.1"
			],
			"tools": [
				"*"
			]
		},
		"github": {
			"type": "local",
			"command": "node",
			"args": [
				"scripts/mcp-github.mjs"
			],
			"tools": [
				"*"
			]
		},
		"playwright": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@0.0.82",
				"--browser",
				"chrome",
				"--isolated",
				"--headless"
			],
			"tools": [
				"*"
			]
		},
		"playwright-firefox": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@0.0.82",
				"--browser",
				"firefox",
				"--isolated",
				"--headless"
			],
			"tools": [
				"*"
			]
		},
		"sqlite": {
			"type": "local",
			"command": "node",
			"args": [
				"scripts/mcp-sqlite.mjs"
			],
			"tools": [
				"*"
			]
		},
		"my-mcp-server-fa42d638": {
			"url": "https://mcp.figma.com/mcp",
			"type": "http"
		}
	}
}
