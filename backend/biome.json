{
	"$schema": "https://biomejs.dev/schemas/2.3.12/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noForEach": "off"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"useIterableCallbackReturn": "off",
				"noImplicitAnyLet": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"noParameterAssign": "off"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "es5"
		}
	},
	"files": {
		"includes": ["src/**/*.ts"]
	}
}
