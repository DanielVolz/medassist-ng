{
  "workspaces": {
    ".": {
      "ignoreDependencies": ["husky", "lint-staged"],
      "ignoreBinaries": ["husky"]
    },
    "backend": {
      "entry": ["src/ui-sandbox.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "frontend": {
      "entry": [
        "src/main.tsx",
        "e2e/*.setup.ts",
        "playwright.all.config.ts",
        "scripts/ui-sandbox-vite.mjs"
      ],
      "ignoreDependencies": ["@fontsource/ibm-plex-mono", "@fontsource/ibm-plex-sans"],
      "ignoreBinaries": ["ffmpeg"]
    },
    "shared": {}
  }
}